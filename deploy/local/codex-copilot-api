#!/bin/sh
set -eu
export CODEX_HOME="$HOME/.codex"

if ! curl --noproxy '*' --fail --silent --max-time 3 http://127.0.0.1:4141/ >/dev/null; then
    printf '%s\n' 'Copilot API is unavailable. Run: systemctl --user start copilot-api.service' >&2
    exit 1
fi

exec "$HOME/.local/bin/codex" --profile copilot-api-community "$@"
